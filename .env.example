# Copia este archivo como .env.local y completa la llave. NO subir .env.local al repo.
CRM_BASE_URL=http://localhost:4000/external/client-access
# Llave de la integración: CRM → Config del sistema → Accesos de clientes → Integraciones (se muestra una sola vez).
CRM_API_KEY=cmk_pega_aqui_tu_llave
# La subida de archivos también usa esta llave: el sitio le pregunta al CRM si el token es válido (no hay más secretos que configurar).

# Webhook de n8n para recibir los archivos (URL completa) y su x-api-key
N8N_WEBHOOK_URL=
N8N_API_KEY=

